{
  "_comment": "COLLECTIVE EDGE COLOR TOKENS v1.0. Mirrors snippets/palette.css exactly. Read by generators that cannot parse CSS: python-pptx, python-docx, matplotlib, reportlab, and any script emitting PPTX, DOCX, XLSX or PDF. Color only. Type values are NOT duplicated here; sizes, weights, leading, tracking and measure live in snippets/type-tokens.json, and the standard they come from is reference/type-system.md. Collective Edge has no hue of its own. White is the document surface, black is a band, and any color on a CE surface belongs to a partner.",
  "brand": "collective-edge",
  "name": "Collective Edge",
  "role": "parent",
  "prefix": "ce",
  "hasColor": false,
  "version": "1.0",
  "typeSystemVersion": "1.0",
  "cdnRoot": "https://cdn.jsdelivr.net/gh/collective-edge/collective-edge-brand-kit@main/",
  "paletteCss": "https://cdn.jsdelivr.net/gh/collective-edge/collective-edge-brand-kit@main/snippets/palette.css",
  "typeTokensJson": "https://cdn.jsdelivr.net/gh/collective-edge/collective-edge-brand-kit@main/snippets/type-tokens.json",

  "palette": {
    "_comment": "The raw brand palette, --ce-*. Collective Edge runs a grey ramp. White is the primary document surface; black is reserved for hero, divider and title surfaces.",
    "black":    { "var": "--ce-black",    "hex": "#000000", "rgb": [0, 0, 0],       "use": "Header bands, title slides, section dividers" },
    "ink":      { "var": "--ce-ink",      "hex": "#111111", "rgb": [17, 17, 17],    "use": "Body text on light" },
    "graphite": { "var": "--ce-graphite", "hex": "#2A2A2A", "rgb": [42, 42, 42],    "use": "Deep neutral, button hover" },
    "slate":    { "var": "--ce-slate",    "hex": "#4A4A4A", "rgb": [74, 74, 74],    "use": "Secondary text" },
    "steel":    { "var": "--ce-steel",    "hex": "#6E6E6E", "rgb": [110, 110, 110], "use": "Tertiary text, metadata" },
    "mute":     { "var": "--ce-mute",     "hex": "#9A9A9A", "rgb": [154, 154, 154], "use": "Dimmed non-text marks. 2.81:1 on white, so never text at any size" },
    "fog":      { "var": "--ce-fog",      "hex": "#C8C8C8", "rgb": [200, 200, 200], "use": "The Edge wedge when CE stands alone. Never text" },
    "mist":     { "var": "--ce-mist",     "hex": "#E2E2E2", "rgb": [226, 226, 226], "use": "Hairlines, dividers. Never text" },
    "paper":    { "var": "--ce-paper",    "hex": "#F4F4F4", "rgb": [244, 244, 244], "use": "Off-white surface tint" },
    "bone":     { "var": "--ce-bone",     "hex": "#FAFAFA", "rgb": [250, 250, 250], "use": "Lightest surface" },
    "white":    { "var": "--ce-white",    "hex": "#FFFFFF", "rgb": [255, 255, 255], "use": "Primary document canvas" }
  },

  "wedge": {
    "_comment": "The Edge wedge is the one part of the block mark that carries color, and that color is the PARTNER's. Every combination ships as a file. Never hand-recolor a mark.",
    "standalone": { "var": "--wedge-standalone", "hex": "#C8C8C8", "rgb": [200, 200, 200] },
    "royal":      { "var": "--wedge-royal",      "hex": "#572E72", "rgb": [87, 46, 114] },
    "apex":       { "var": "--wedge-apex",       "hex": "#F9AD16", "rgb": [249, 173, 22] }
  },

  "foreground": {
    "_comment": "Semantic layer. Identical variable names in every brand, so a component written for one brand renders correctly in another with only palette.css swapped.",
    "fg-1":         { "hex": "#111111", "rgb": [17, 17, 17],    "use": "Primary text on light" },
    "fg-2":         { "hex": "#4A4A4A", "rgb": [74, 74, 74],    "use": "Secondary text" },
    "fg-3":         { "hex": "#6E6E6E", "rgb": [110, 110, 110], "use": "Tertiary text, metadata" },
    "fg-4":         { "hex": "#9A9A9A", "rgb": [154, 154, 154], "use": "Dimmed non-text marks. 2.81:1 on white, so never text. The dimmest text on white is #6E6E6E at 5.10:1" },
    "fg-accent":    { "hex": "#111111", "rgb": [17, 17, 17],    "use": "Brand-colored text. CE has no hue, so this is ink" },
    "fg-on-dark-1": { "hex": "#FFFFFF", "rgb": [255, 255, 255], "use": "Primary text on dark" },
    "fg-on-dark-2": { "hex": "#D6D6D6", "rgb": [214, 214, 214], "use": "Body on dark" },
    "fg-on-dark-3": { "hex": "#9E9E9E", "rgb": [158, 158, 158], "use": "Captions and eyebrows on dark" }
  },

  "background": {
    "bg-canvas":   { "hex": "#FFFFFF", "rgb": [255, 255, 255], "use": "Document canvas" },
    "bg-surface":  { "hex": "#FAFAFA", "rgb": [250, 250, 250], "use": "Flat cards, sub-banner" },
    "bg-elevated": { "hex": "#FFFFFF", "rgb": [255, 255, 255], "use": "Raised surface" },
    "bg-inverse":  { "hex": "#000000", "rgb": [0, 0, 0],       "use": "Inverse surface" },
    "bg-band":     { "hex": "#000000", "rgb": [0, 0, 0],       "use": "Header band, title slide, section divider" }
  },

  "border": {
    "border-1":         { "hex": "#E2E2E2", "rgb": [226, 226, 226], "use": "Hairlines and dividers" },
    "border-2":         { "hex": "#D0D0D0", "rgb": [208, 208, 208], "use": "Stronger rule, table header underline" },
    "border-on-dark":   { "rgba": "rgba(255,255,255,0.12)", "rgb": [255, 255, 255], "alpha": 0.12, "use": "Rules inside a dark band" },
    "border-band-rule": { "hex": null, "use": "Collective Edge ships no accent rule under its band. Apex uses gold here" }
  },

  "status": {
    "_comment": "Identical in every brand so an operational signal never changes meaning between documents. Use functionally and sparingly, always paired with text or an arrow. A brand accent is never a status color.",
    "go":   { "hex": "#1E7A4D", "rgb": [30, 122, 77],   "use": "Operational green" },
    "warn": { "hex": "#B5821A", "rgb": [181, 130, 26],  "use": "Attention amber" },
    "stop": { "hex": "#B0322B", "rgb": [176, 50, 43],   "use": "Alert red" },
    "info": { "hex": "#2A5A8C", "rgb": [42, 90, 140],   "use": "Info blue" }
  },

  "diagramRoles": {
    "_comment": "Identical across every brand so a diagram reads the same regardless of whose document it sits in. Rectangles, 6px radius. Role is communicated by fill, never by shape. Never invent new hues for these roles.",
    "decision": { "fill": "#4a8e3a", "fillRgb": [74, 142, 58], "border": "#3a7029", "borderRgb": [58, 112, 41], "use": "Decision boxes, questions, branch points" },
    "warning":  { "fill": "#f57c00", "fillRgb": [245, 124, 0], "border": "#cc6600", "borderRgb": [204, 102, 0], "use": "Warnings, advisories" },
    "process":  { "fill": "#3e3e3e", "fillRgb": [62, 62, 62],  "border": "#2a2a2a", "borderRgb": [42, 42, 42],  "use": "Neutral process steps, context boxes" },
    "connector": { "stroke": "#3e3e3e", "strokeRgb": [62, 62, 62], "width": "1.8pt" },
    "shape": "rectangles, 6px radius"
  },

  "logos": {
    "_comment": "Ask for a role, never for a filename. Partner kits map the same five roles to different filenames. `-on-light` is the version to place ON a light background. Collective Edge ships no stacked lockup.",
    "horizontal-on-light": "https://cdn.jsdelivr.net/gh/collective-edge/collective-edge-brand-kit@main/assets/logos/horizontal-black.svg",
    "horizontal-on-dark":  "https://cdn.jsdelivr.net/gh/collective-edge/collective-edge-brand-kit@main/assets/logos/horizontal-white.svg",
    "mark-on-light":       "https://cdn.jsdelivr.net/gh/collective-edge/collective-edge-brand-kit@main/assets/logos/mark-black.svg",
    "mark-on-dark":        "https://cdn.jsdelivr.net/gh/collective-edge/collective-edge-brand-kit@main/assets/logos/mark-white.svg",
    "stacked-on-dark":     null,
    "minWidth": { "horizontal": "120px", "mark": "28px" },
    "viewBox": { "horizontal": "0 0 450 74.999997", "mark": "0 0 375 262.499992" }
  },

  "cobrandMarks": {
    "_comment": "The Edge wedge carries the partner's hue. Every combination ships as a file. Never hand-recolor a mark.",
    "royal": {
      "on-light": "https://cdn.jsdelivr.net/gh/collective-edge/collective-edge-brand-kit@main/assets/logos/mark-black-royal.svg",
      "on-dark":  "https://cdn.jsdelivr.net/gh/collective-edge/collective-edge-brand-kit@main/assets/logos/mark-white-royal.svg"
    },
    "apex": {
      "on-light": "https://cdn.jsdelivr.net/gh/collective-edge/collective-edge-brand-kit@main/assets/logos/mark-black-apex.svg",
      "on-dark":  "https://cdn.jsdelivr.net/gh/collective-edge/collective-edge-brand-kit@main/assets/logos/mark-white-apex.svg"
    }
  },

  "radius": { "none": "0", "sm": "2px", "md": "6px", "lg": "12px", "pill": "999px" },

  "shadow": {
    "_comment": "The house is flat. Shadow signals elevation, never decoration.",
    "1": "0 1px 2px rgba(0,0,0,0.06)",
    "2": "0 4px 12px rgba(0,0,0,0.08)",
    "3": "0 12px 32px rgba(0,0,0,0.12)"
  },

  "motion": {
    "easeStandard": "cubic-bezier(0.2, 0, 0, 1)",
    "easeOut": "cubic-bezier(0.16, 1, 0.3, 1)",
    "durFast": "120ms", "durBase": "200ms", "durSlow": "360ms"
  }
}
